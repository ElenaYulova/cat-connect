<mvc:View controllerName="sap.capire.gameshop.controller.SalesOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:app="http://sap.com" displayBlock="true">

    <f:DynamicPage id="salesOrderPage" headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>salesOrder.page.title}" titleStyle="H5" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>
                <OverflowToolbar class="sapUiSmallMarginBottom">
                    <!-- Filter by Title  -->
                    <SearchField id="searchTitleField" placeholder="{i18n>salesOrder.placeholder.search}" width="230px" search=".onCatalogFiltersTrigger" />

                    <ToolbarSeparator />

                    <!-- Filter by Category -->
                    <ComboBox id="categorySelect" placeholder="{i18n>salesOrder.placeholder.category}" showClearIcon="true" change=".onCatalogFiltersTrigger" width="220px" />
                    <CheckBox id="parentCategoryCheckBox" text="{i18n>salesOrder.checkbox.childCategories}" select=".onCatalogFiltersTrigger" enabled="true" />

                    <ToolbarSeparator />

                    <!-- Filter by Stock-->
                    <Label text="{i18n>salesOrder.label.inStock}" />
                    <Switch id="stockFilterSwitch" state="true" change=".onCatalogFiltersTrigger" tooltip="{i18n>salesOrder.tooltip.stockSwitch}" />

                    <!-- Filter by Price Range -->
                    <Label text="{i18n>salesOrder.label.priceLimit}" class="sapUiSmallMarginBegin" />
                    <Select id="priceFilterCombo" change=".onCatalogFiltersTrigger" width="150px" tooltip="{i18n>salesOrder.tooltip.priceSelect}">
                        <items>
                            <core:Item key="all" text="{i18n>salesOrder.price.all}" />
                            <core:Item key="20" text="{i18n>salesOrder.price.under20}" />
                            <core:Item key="50" text="{i18n>salesOrder.price.under50}" />
                            <core:Item key="100" text="{i18n>salesOrder.price.under100}" />
                        </items>
                    </Select>
                </OverflowToolbar>
                <Table id="gamesTable" growing="true" growingThreshold="10" sticky="ColumnHeaders" items="{
                        path: '/Products',
                        parameters: {
                            $expand: 'genre'
                        }
                    }">
                    <columns>
                        <Column width="4rem" hAlign="Center">
                            <Text text="{i18n>salesOrder.column.cover}" />
                        </Column>
                        <Column>
                            <Button text="{i18n>salesOrder.column.gameTitle}" type="Transparent" icon="sap-icon://sort" iconFirst="false" press=".onSortTitle" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>salesOrder.column.category}" />
                        </Column>
                        <Column hAlign="End">
                            <Button text="{i18n>salesOrder.column.price}" type="Transparent" icon="sap-icon://sort" iconFirst="false" press=".onSortPrice" />
                        </Column>
                        <Column hAlign="Center" width="6rem">
                            <Text text="{i18n>salesOrder.column.buy}" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem type="Navigation" press=".onNavToGenericDetails" app:targetRoute="ProductDetails">
                            <cells>
                                <Image src="{image}" width="2.5rem" height="2.5rem" class="productImage" error=".onImageLoadError" />

                                <ObjectIdentifier title="{title}" />
                                <Text text="{genre/name}" />
                                <ObjectNumber number="{price}" unit="USD" />
                                <!-- TODO: Add Disabling when out of stock-->
                                <Button icon="sap-icon://add-product" type="Transparent" tooltip="{i18n>salesOrder.tooltip.addToCart}" enabled="{userRoles>/isLoggedIn}" press=".onQuickAddToCart" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
