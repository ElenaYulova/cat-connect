<mvc:View
    controllerName="sap.capire.gameshop.controller.SalesOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:app="http://sap.com"
    displayBlock="true">

    <f:DynamicPage id="salesOrderPage" headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Games Showcase" titleStyle="H5" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>
                <OverflowToolbar class="sapUiSmallMarginBottom">
                    <SearchField 
                        id="searchTitleField"
                        placeholder="Search by title..."
                        width="250px"
                        search=".onSearch" />

                    <ToolbarSeparator />
                    <ComboBox
                        id="categorySelect"
                        placeholder="Select Category..."
                        showClearIcon="true"
                        change=".onCategoryChange"
                        width="240px" />
                    <CheckBox
                        id="parentCategoryCheckBox"
                        text="Include Child Categories"
                        select=".onCategoryChange"
                        enabled="true" />
                </OverflowToolbar>

                <Table
                    id="gamesTable"
                    growing="true"
                    growingThreshold="10"
                    sticky="ColumnHeaders"
                    items="{
                        path: '/Products',
                        parameters: {
                            $expand: 'genre',
                            $filter: 'stock gt 0'
                        }
                    }">
                    <columns>
                        <Column width="4rem" hAlign="Center">
                            <Text text="Cover" />
                        </Column>
                        <Column>
                            <Button text="Game Title" type="Transparent" icon="sap-icon://sort" iconFirst="false" press=".onSortTitle" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="Category" />
                        </Column>
                        <Column hAlign="End">
                            <Button text="Retail Price" type="Transparent" icon="sap-icon://sort" iconFirst="false" press=".onSortPrice" />
                        </Column>
                        <Column hAlign="Center" width="6rem">
                            <Text text="Buy" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            type="Navigation"
                            press=".onNavToGenericDetails"
                            app:targetRoute="ProductDetails">
                            <cells>
                                <Image
                                    src="{image}"
                                    width="2.5rem"
                                    height="2.5rem"
                                    class="productImage"
                                    error=".onImageLoadError" />

                                <ObjectIdentifier title="{title}" />
                                <Text text="{genre/name}" />
                                <ObjectNumber number="{price}" unit="USD" />

                                <Button
                                    icon="sap-icon://add-product"
                                    type="Transparent"
                                    tooltip="Quick Add to Cart"
                                    enabled="{userRoles>/isLoggedIn}"
                                    press=".onQuickAddToCart" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
