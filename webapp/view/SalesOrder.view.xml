<mvc:View
    controllerName="sap.capire.gameshop.controller.SalesOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <f:DynamicPage
        id="gamesPage"
        toggleHeaderOnTitleClick="false"
        headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Game Shop Overview" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader>
                <core:Fragment
                    id="filterFragment"
                    fragmentName="sap.capire.gameshop.view.fragments.GamesFilter"
                    type="XML" />
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table
                id="gamesTable"
                growing="true"
                growingThreshold="10"
                items="{
                    path: '/Products',
                    parameters: {
                        $$updateGroupId: 'gamesUpdateGroup'
                    }
                }">

                <columns>
                    <Column><Text text="Title" /></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Genre" /></Column>
                    <Column hAlign="End"><Text text="Price" /></Column>
                </columns>

                <items>
                    <core:Fragment
                        id="rowFragment"
                        fragmentName="sap.capire.gameshop.view.fragments.GameRow"
                        type="XML" />
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
