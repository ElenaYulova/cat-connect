<mvc:View controllerName="sap.capire.gameshop.controller.OrderDetails"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form">
    <Page id="orderDetailsPage" title="{i18n>orderDetails.page.title}" showNavButton="true" navButtonPress="onNavBack">
        <headerContent>
            <Button id="cancelOrderButton" icon="sap-icon://cancel" text="{i18n>orderDetails.button.cancelOrder}" type="Default" press="onCancelOrder" />
            <Button id="deleteOrderButton" icon="sap-icon://delete" text="{i18n>orderDetails.button.deleteOrder}" type="Reject" visible="{= ${userRoles>/isSalesManager} || ${userRoles>/isCRMAdmin}}" press="onDeleteOrder" />
        </headerContent>

        <content>
            <ObjectHeader id="orderHeader" title="{i18n>orderDetails.header.title}" number="{totalAmount}" numberUnit="USD">
                <!-- TODO: Dynamic Currency context binding -->
                <attributes>
                    <ObjectAttribute text="Order UUID: {ID}" />
                    <ObjectAttribute text="Placement Date: {
                        path: 'createdAt',
                        formatOptions: { style: 'medium' }
                    }" />
                    <!-- TODO: Add feature with Loyalty Saving Sums across historical log -->
                    <ObjectAttribute id="discountAttribute" text="" />
                </attributes>
                <statuses>
                    <ObjectStatus text="{path: 'status_code', formatter: '.formatter.orderStatusText'}" state="{path: 'status_code', formatter: '.formatter.orderStatusState'}" inverted="true" />
                </statuses>
            </ObjectHeader>

            <IconTabBar id="orderTabBar" upperCase="true" class="sapUiResponsiveContentPadding">
                <items>
                    <!-- TAB 1: ORDER ITEMS -->
                    <IconTabFilter id="tabItems" icon="sap-icon://basket" text="{i18n>orderDetails.tab.items}">
                        <Table id="orderItemsTable" items="{items}" growing="true" growingThreshold="10">
                            <columns>
                                <Column width="6rem">
                                    <Text text="{i18n>orderDetails.table.column.cover}" />
                                </Column>
                                <Column>
                                    <Text text="{i18n>orderDetails.table.column.gameTitle}" />
                                </Column>
                                <Column width="8rem" hAlign="Right">
                                    <Text text="{i18n>orderDetails.table.column.price}" />
                                </Column>
                                <Column width="6rem" hAlign="Center">
                                    <Text text="{i18n>orderDetails.table.column.quantity}" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem vAlign="Middle">
                                    <cells>
                                        <Image src="{game/image}" width="4rem" alt="{i18n>orderDetails.table.column.cover}" error=".onImageLoadError" />

                                        <ObjectIdentifier title="{game/title}" />
                                        <!-- TODO: Add Currency -->
                                        <ObjectNumber number="{game/price}" unit="USD" />

                                        <Text text="{= ${i18n>orderDetails.table.unit.pcs}.replace('{0}', ${quantity}) }" />

                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <!-- TAB 2: FEEDBACKS -->
                    <IconTabFilter id="tabFeedbacks" icon="sap-icon://comment" text="{i18n>orderDetails.tab.feedbacks}">
                        <VBox class="sapUiMediumMargin">

                            <MessageStrip id="reviewStatusNoAccessStrip" text="{i18n>orderDetails.review.noAccess}" type="Warning" showIcon="true" visible="{localView>/isReviewLocked}" class="sapUiSmallMarginBottom" />

                            <VBox id="reviewFormContainer" visible="{localView>/isReviewFormVisible}">
                                <Title text="{i18n>orderDetails.review.form.title}" level="H3" class="sapUiSmallMarginBottom" />
                                <Text text="{i18n>orderDetails.review.form.description}" class="sapUiMediumMarginBottom" />
                                <VBox class="sapUiSmallMarginBottom">
                                    <Label text="{i18n>orderDetails.review.form.labelRating}" required="true" class="sapUiTinyMarginBottom" />
                                    <RatingIndicator id="feedbackRatingIndicator" maxValue="5" value="5" visualMode="Full" class="sapUiTinyMarginBottom" />
                                </VBox>

                                <VBox class="sapUiMediumMarginBottom">
                                    <Label text="{i18n>orderDetails.review.form.labelComment}" required="true" class="sapUiTinyMarginBottom" />
                                    <TextArea id="feedbackTextArea" width="100%" rows="5" placeholder="{i18n>orderDetails.review.form.placeholderComment}" maxLength="1000" growing="true" />
                                </VBox>

                                <Button id="submitReviewButton" text="{i18n>orderDetails.review.form.buttonSubmit}" icon="sap-icon://paper-plane" type="Emphasized" press="onSubmitReview" width="12rem" />
                            </VBox>

                            <VBox id="reviewReadOnlyContainer" visible="{localView>/isReviewReadOnlyVisible}">
                                <Title text="{i18n>orderDetails.review.read.title}" level="H3" class="sapUiSmallMarginBottom" />

                                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                    <Label text="{i18n>orderDetails.review.read.labelRating}" class="sapUiTinyMarginEnd" />
                                    <RatingIndicator id="savedRatingIndicator" maxValue="5" editable="false" />
                                </HBox>

                                <Label text="{i18n>orderDetails.review.read.labelComment}" />
                                <Text id="savedCommentText" class="sapUiMediumMarginBottom sapUiSelectable" />

                                <VBox class="sapUiMediumMarginTop" visible="{= ${userRoles>/isSalesManager} || ${userRoles>/isCRMAdmin} || ${userRoles>/isAdmin} }">
                                    <Title text="{i18n>orderDetails.review.admin.title}" level="H4" class="sapUiSmallMarginBottom" />
                                    <Label text="{i18n>orderDetails.review.admin.labelApprove}" class="sapUiTinyMarginBottom" />
                                    <Switch id="smmApprovalSwitch" state="false" customTextOn="Yes" customTextOff="No" change="onSmmSwitchChange" />
                                </VBox>
                            </VBox>

                        </VBox>
                    </IconTabFilter>
                    <!-- TAB 3: CUSTOMER INSIGHTS -->
                    <IconTabFilter id="tabCustomer" icon="sap-icon://customer" text="{i18n>orderDetails.tab.customer}">

                        <VBox id="customerFragmentContainer" binding="{customer}">
                            <core:Fragment fragmentName="sap.capire.gameshop.view.fragments.CustomerInsightsForm" type="XML" />
                        </VBox>
                    </IconTabFilter>

                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
