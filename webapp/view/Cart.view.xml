<mvc:View controllerName="sap.capire.gameshop.controller.Cart"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page title="{i18n>cart.page.title}" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <VBox class="sapUiResponsiveMargin">

                <Table id="cartTable" noDataText="{i18n>cart.table.noData}" items="{cart>/items}">

                    <columns>
                        <Column width="4rem" hAlign="Center">
                            <Text text="{i18n>cart.column.cover}" />
                        </Column>
                        <Column>
                            <Text text="{i18n>cart.column.gameTitle}" />
                        </Column>
                        <Column width="15%" hAlign="End">
                            <Text text="{i18n>cart.column.price}" />
                        </Column>
                        <Column width="15%" hAlign="Center">
                            <Text text="{i18n>cart.column.quantity}" />
                        </Column>
                        <Column width="15%" hAlign="End">
                            <Text text="{i18n>cart.column.subtotal}" />
                        </Column>
                        <Column width="10%" hAlign="Center">
                            <Text text="{i18n>cart.column.action}" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <Image src="{cart>image}" width="2.5rem" height="2.5rem" class="productImage" error=".onImageLoadError" />

                                <ObjectIdentifier title="{cart>title}" />

                                <ObjectNumber number="{cart>price}" unit="USD" />

                                <StepInput value="{cart>quantity}" min="1" max="{cart>stock}" width="120px" change=".onQuantityChange" />

                                <ObjectNumber number="{= (${cart>price} * ${cart>quantity}).toFixed(2) }" unit="USD" state="Success" />

                                <Button icon="sap-icon://delete" type="Reject" press=".onRemoveItem" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <VBox class="sapUiMediumMarginTop sapUiAlignmentEnd" width="100%">
                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                        <Label text="{i18n>cart.label.totalItems}" class="sapUiSmallMarginEnd" />
                        <Text text="{cart>/totalItems}" class="sapUiBoldText" />
                    </HBox>

                    <!-- Total Gross Amount-->
                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                        <Label text="{i18n>cart.label.totalItems}" class="sapUiSmallMarginEnd" />
                        <ObjectNumber number="{
                                path: 'cart>/totalPrice',
                                formatOptions: {
                                    minFractionDigits: 2,
                                    maxFractionDigits: 2
                                }
                            }" unit="USD" state="None" />
                    </HBox>

                    <!-- Client Discount-->
                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                        <Label text="{i18n>cart.label.totalDiscount}" class="sapUiSmallMarginEnd" />
                        <ObjectNumber number="{
                                path: 'cart>/clientDiscount',
                                formatOptions: {
                                    minFractionDigits: 2,
                                    maxFractionDigits: 2
                                }
                            }" unit="USD" state="Warning" />
                    </HBox>

                    <!-- Final Estimated Total-->
                    <HBox alignItems="Center" class="sapUiMediumMarginBottom">
                        <Label text="{i18n>cart.label.estimatedTotal}" class="sapUiSmallMarginEnd" />
                        <ObjectNumber number="{
                                path: 'cart>/estimatedTotal',
                                formatOptions: {
                                    minFractionDigits: 2,
                                    maxFractionDigits: 2
                                }
                            }" unit="USD" emphasized="true" state="Information" />
                    </HBox>

                    <Button text="{i18n>cart.button.submitOrder}" type="Accept" icon="sap-icon://shipping-status" enabled="{= ${cart>/items}.length > 0 }" press=".onSubmitOrder" width="220px" />

                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
