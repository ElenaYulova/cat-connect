<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog id="actionCancelDialog" title="{i18n>actionDialog.title}" type="Message">
        <content>
            <form:SimpleForm editable="true" layout="ResponsiveGridLayout">
                <form:content>
                    <Label text="{i18n>actionDialog.label.reason}" required="true" />
                    <Input id="reasonInput" placeholder="{i18n>actionDialog.placeholder.reason}" showValueHelp="true" valueHelpRequest=".onReasonValueHelp" tooltip="{i18n>actionDialog.tooltip.reason}" />

                    <Label text="{i18n>actionDialog.label.platform}" required="true" />
                    <Input id="destinationInput" placeholder="{i18n>actionDialog.placeholder.platform}" showValueHelp="true" valueHelpRequest=".onDestinationValueHelp" tooltip="{i18n>actionDialog.tooltip.platform}" />

                    <Label text="{i18n>actionDialog.label.comment}" />
                    <TextArea id="cancelCommentArea" rows="3" placeholder="{i18n>actionDialog.placeholder.comment}" tooltip="{i18n>actionDialog.tooltip.comment}" />
                </form:content>
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button text="{i18n>actionDialog.button.confirm}" type="Reject" icon="sap-icon://decline" press=".onConfirmOrderCancellation" tooltip="{i18n>actionDialog.button.confirmTooltip}" />
        </beginButton>
        <endButton>
            <Button text="{i18n>actionDialog.button.close}" press=".onCloseCancelDialog" tooltip="{i18n>actionDialog.tooltip.close}" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
