<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog id="actionCancelDialog" title="Order Cancellation Control" type="Message">
        <content>
            <form:SimpleForm editable="true" layout="ResponsiveGridLayout">
                <form:content>
                    <Label text="Cancellation Reason" required="true" />
                    <Input id="reasonInput" placeholder="Select official reason code..." showValueHelp="true" valueHelpRequest=".onReasonValueHelp" tooltip="Click to open Search Help for official cancellation codes" />

                    <Label text="License Platform" required="true" />
                    <Input id="destinationInput" placeholder="Select gaming platform launcher..." showValueHelp="true" valueHelpRequest=".onDestinationValueHelp" tooltip="Select target gaming platform or digital launcher for license validation" />

                    <Label text="Internal Comment" />
                    <TextArea id="cancelCommentArea" rows="3" placeholder="Enter internal manager notes..." tooltip="Internal audit notes regarding this cancellation workflow" />
                </form:content>
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button text="Confirm Cancel" type="Reject" icon="sap-icon://decline" press=".onConfirmOrderCancellation" tooltip="Permanently cancel order, revoke digital keys, and execute inventory rollback" />
        </beginButton>
        <endButton>
            <Button text="Close" press=".onCloseCancelDialog" tooltip="Dismiss dialog window without committing changes" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
