<mvc:View controllerName="sap.capire.gameshop.controller.OrdersList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="ordersListPage" title="{i18n>ordersList.page.title}" showNavButton="true" navButtonPress="onNavBack">
        <content>
            <!-- Filterbar -->
            <Panel expandable="true" headerText="{i18n>ordersList.panel.header}" expanded="true" class="sapUiSmallMarginBottom">
                <content>
                    <FlexBox wrap="Wrap" alignItems="End" justifyContent="SpaceBetween">
                        <items>
                            <!-- Filter 1: Order Number & Customer Name Search -->
                            <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                <Label text="{i18n>ordersList.label.search}" design="Bold" />
                                <SearchField id="filterOrderNumber" placeholder="{i18n>ordersList.placeholder.search}" width="14rem" search="onApplyFilters" />
                            </VBox>

                            <!-- Filter 2: Status Selection -->
                            <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                <Label text="{i18n>ordersList.label.status}" design="Bold" />
                                <Select id="filterStatus" width="12rem" change="onApplyFilters">
                                    <core:Item key="ALL" text="{i18n>ordersList.status.all}" />
                                    <core:Item key="N" text="{i18n>ordersList.status.new}" />
                                    <core:Item key="P" text="{i18n>ordersList.status.progress}" />
                                    <core:Item key="C" text="{i18n>ordersList.status.completed}" />
                                    <core:Item key="X" text="{i18n>ordersList.status.cancelled}" />
                                </Select>
                            </VBox>

                            <!-- Filter 3: Date Range Selection -->
                            <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                <Label text="{i18n>ordersList.label.dateRange}" design="Bold" />
                                <DateRangeSelection id="filterDateRange" width="18rem" displayFormat="yyyy-MM-dd" change="onApplyFilters" />
                            </VBox>

                            <!-- Reset Button -->
                            <Button icon="sap-icon://clear-filter" text="{i18n>ordersList.button.reset}" type="Transparent" class="sapUiTinyMarginBottom" press="onResetFilters" />

                        </items>
                    </FlexBox>
                </content>
            </Panel>

            <!-- Table -->
            <Table id="ordersTable" items="{
                    path: '/Orders',
                    parameters: {
                        $orderby: 'createdAt desc',
                        $expand: 'customer'
                    }
                }" growing="true" growingThreshold="10" class="sapUiResponsiveMargin">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>ordersList.table.title}"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://refresh" tooltip="{i18n>ordersList.tooltip.refresh}" press="onRefreshOrders"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <!-- 1. Order Reference -->
                    <Column width="16rem">
                        <Button text="{i18n>ordersList.column.reference}" type="Transparent" icon="sap-icon://sort" iconFirst="false" press=".onSortOrderNumber" />
                    </Column>

                    <!-- 2. Customer Name -->
                    <Column id="colCustomer" visible="{= ${userRoles>/isSalesManager} || ${userRoles>/isCRMAdmin} || ${userRoles>/isAdmin} }" width="14rem">
                        <Text text="{i18n>ordersList.column.customer}" />
                    </Column>

                    <!-- 3. Total sum -->
                    <Column minScreenWidth="Tablet" demandPopin="true" width="8rem">
                        <Button text="{i18n>ordersList.column.sum}" type="Transparent" icon="sap-icon://sort" iconFirst="false" press=".onSortTotalAmount" />
                    </Column>

                    <!-- 4. Games Qty -->
                    <Column minScreenWidth="Tablet" demandPopin="true" width="8rem">
                        <Text text="{i18n>ordersList.column.quantity}" />
                    </Column>

                    <!-- 5. Placement Date -->
                    <Column minScreenWidth="Desktop" demandPopin="true" width="12rem">
                        <Button text="{i18n>ordersList.column.date}" type="Transparent" icon="sap-icon://sort" iconFirst="false" press=".onSortCreatedAt" />
                    </Column>

                    <!-- 6. Status -->
                    <Column width="10rem" hAlign="Center">
                        <Button text="{i18n>ordersList.column.status}" type="Transparent" icon="sap-icon://sort" iconFirst="false" press=".onSortStatus" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem vAlign="Middle" type="Navigation" press=".onOrderDetailsPress">
                        <cells>
                            <!-- 1. Order Reference -->
                            <ObjectIdentifier title="{= ${orderNumber} ? ${orderNumber} : ${ID} }" />

                            <!-- 2. Customer Name -->
                            <Text text="{
                                parts: [
                                    {path: 'customer/firstName'},
                                    {path: 'customer/lastName'}
                                ],
                                formatter: '.formatter.formatCustomerFullName'
                            }" />
                            <!-- 3. Total Gross -->
                            <ObjectNumber number="{totalAmount}" unit="{currency_code}" />

                            <!-- 4. Games Qty -->
                            <Text text="{= ${i18n>orderDetails.table.unit.pcs}.replace('{0}', ${items/$count}) }" />

                            <!-- 5. Placement Date -->
                            <Text text="{
                                path: 'createdAt',
                                formatOptions: {
                                    style: 'medium'
                                }
                            }" />

                            <ObjectStatus text="{
                                    path: 'status_code',
                                    formatter: '.formatter.orderStatusText'
                                }" state="{
                                    path: 'status_code',
                                    formatter: '.formatter.orderStatusState'
                                }" inverted="true" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
