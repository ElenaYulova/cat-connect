{
    "_version": "1.58.0",
    "sap.app": {
        "id": "sap.capire.gameshop",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "title": "Game Shop Management",
        "description": "Freestyle SAPUI5 Application for Sales Order Management"
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexibilityRootPredicate": "",
        "handleValidation": true,
        "fullWidth": true,
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },

        "rootView": {
            "viewName": "sap.capire.gameshop.view.App",
            "type": "XML",
            "async": true,
            "id": "App"
        },

        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.f": {},
                "sap.ui.layout": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "sap.capire.gameshop.i18n.i18n",
                    "supportedLocales": ["", "ru"],
                    "fallbackLocale": ""
                }
            },
            "": {
                "type": "sap.ui.model.odata.v4.ODataModel",
                "settings": {
                    "synchronizationMode": "None",
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "serviceUrl": "/odata/v4/sales-order/",
                    "httpHeaders": {
                        "Authorization": "Basic YWRtaW46"
                    }
                }
            }
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "viewType": "XML",
                "async": true,
                "viewPath": "sap.capire.gameshop.view",
                "rootControl": "container-gameshop---App",
                "controlId": "salesOrderApp",
                "controlAggregation": "pages",
                "transition": "slide"
            },
            "routes": [
                {
                    "name": "SalesOrder",
                    "pattern": "",
                    "target": ["TargetSalesOrder"]
                },
                {
                    "name": "ProductDetails",
                    "pattern": "Products/{productId}",
                    "target": ["TargetProductDetails"]
                },
                {
                    "name": "OrdersList",
                    "pattern": "orders",
                    "target": ["TargetOrdersList"]
                },
                {
                    "name": "OrderDetails",
                    "pattern": "orders/{orderId}",
                    "target": ["TargetOrderDetails"]
                },
                {
                    "name": "Cart",
                    "pattern": "cart",
                    "target": "TargetCart"
                }
            ],
            "targets": {
                "TargetSalesOrder": {
                    "viewName": "SalesOrder",
                    "viewLevel": 1,
                    "controlId": "salesOrderApp",
                    "controlAggregation": "pages"
                },
                "TargetProductDetails": {
                    "viewName": "ProductDetails",
                    "viewLevel": 2,
                    "controlId": "salesOrderApp",
                    "controlAggregation": "pages"
                },
                "TargetOrdersList": {
                    "viewName": "OrdersList",
                    "viewLevel": 2,
                    "controlId": "salesOrderApp",
                    "controlAggregation": "pages"
                },
                "TargetCart": {
                    "viewName": "Cart",
                    "viewLevel": 2,
                    "controlId": "salesOrderApp",
                    "controlAggregation": "pages"
                },
                "TargetOrderDetails": {
                    "viewName": "OrderDetails",
                    "viewLevel": 3,
                    "controlId": "salesOrderApp",
                    "controlAggregation": "pages"
                }
            }
        }
    }
}
