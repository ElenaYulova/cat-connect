{
    "_version": "1.58.0",
    "sap.app": {
        "id": "sap.capire.gameshop",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "title": "Game Shop Management",
        "description": "Freestyle SAPUI5 Application for Sales Order Management"
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexibilityRootPredicate": "",
        "handleValidation": true,
        "rootView": {
            "viewName": "sap.capire.gameshop.view.SalesOrder",
            "type": "XML",
            "async": true,
            "id": "SalesOrder"
        },
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.f": {},
                "sap.ui.layout": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "sap.capire.gameshop.i18n.i18n",
                    "supportedLocales": ["", "ru"],
                    "fallbackLocale": ""
                }
            },
            "": {
                "type": "sap.ui.model.odata.v4.ODataModel",
                "settings": {
                    "synchronizationMode": "None",
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "serviceUrl": "http://localhost:4004/odata/v4/sales-order/",
                    "httpHeaders": {
                        "Authorization": "Basic YWRtaW46"
                    }
                }
            }
        }
    }
}
