{
  "welcomeFile": "/launchpad.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/v4/(.*)$",
      "target": "/odata/v4/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/user-api(.*)",
      "target": "$1",
      "service": "sap-approuter-userapi"
    },
    {
      "source": "^/crm_customers/(.*)$",
      "target": "$1",
      "localDir": "crm_customers",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.CRMAdmin",
        "$XSAPPNAME.SalesManager",
        "$XSAPPNAME.SupportAgent"
      ]
    },
    {
      "source": "^/crm_app/(.*)$",
      "target": "$1",
      "localDir": "crm_customers",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.CRMAdmin",
        "$XSAPPNAME.SalesManager",
        "$XSAPPNAME.SupportAgent"
      ]
    },
    {
      "source": "^/sales_order/(.*)$",
      "target": "$1",
      "localDir": "sales_order",
      "cacheControl": "no-cache",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.CRMAdmin",
        "$XSAPPNAME.SalesManager",
        "$XSAPPNAME.Customer",
        "$XSAPPNAME.Supplier"
      ]
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "sales_order",
      "authenticationType": "xsuaa"
    }
  ]
}
