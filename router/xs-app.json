{
  "welcomeFile": "/crm_customers/index.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/odata/v4/(.*)$",
      "target": "/odata/v4/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "localDir": ".",
      "authenticationType": "none"
    }
  ]
}