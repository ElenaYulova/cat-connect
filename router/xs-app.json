{
  "welcomeFile": "/launchpad.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/odata/v4/(.*)$",
      "target": "/odata/v4/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/user-api(.*)",
      "target": "$1",
      "service": "sap-approuter-userapi"
    },
    {
      "source": "^/crm_customers/(.*)$",
      "target": "$1",
      "localDir": "crm_customers",
      "authenticationType": "none"
    },
    {
      "source": "^/crm_app/(.*)$",
      "target": "$1",
      "localDir": "crm_customers",
      "authenticationType": "none"
    },
    {
      "source": "^/sales_order/(.*)$",
      "target": "$1",
      "localDir": "sales_order",
      "cacheControl": "no-cache",
      "authenticationType": "none"
    },
    {
      "source": "^/launchpad.html$",
      "target": "/launchpad.html",
      "localDir": "sales_order",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "sales_order",
      "authenticationType": "none"
    }
  ]
}
