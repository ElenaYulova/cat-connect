{
  "welcomeFile": "/fioriSandbox.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/odata/v4/(.*)$",
      "target": "/odata/v4/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/user-api(.*)",
      "target": "$1",
      "service": "sap-approuter-userapi"
    },
    {
      "source": "^/fioriSandbox.html$",
      "localDir": "../webapp",
      "authenticationType": "none"
    },
    {
      "source": "^/sales_order/(.*)$",
      "target": "$1",
      "localDir": "../webapp/sales_order",
      "cacheControl": "no-cache",
      "authenticationType": "none"
    },
    {
      "source": "^/crm_customers/(.*)$",
      "target": "$1",
      "localDir": "../app/crm_customers",
      "authenticationType": "none"
    },
    {
      "source": "^/crm_app/(.*)$",
      "target": "$1",
      "localDir": "../app/crm_customers",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "../webapp",
      "authenticationType": "none"
    }
  ]
}
