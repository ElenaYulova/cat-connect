{
  "welcomeFile": "/index.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/odata/v4/(.*)$",
      "target": "/odata/v4/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/sales_order/(.*)$",
      "target": "$1",
      "localDir": "sales_order",
      "cacheControl": "no-cache",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "localDir": ".",
      "authenticationType": "none"
    }
  ]
}
