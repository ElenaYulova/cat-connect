{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./srv",
    "rootDirs": [
      "./srv",
      "./db"
    ],
    "paths": {
      "#cds-models/*": [
        "./@cds-models/*"
      ],
      "@sap/cds": [
        "./node_modules/@cap-js/cds-types"
      ],
      // 🎨 ВОЗВРАЩАЕМ ПРЕСЕТЫ SAPUI5: Мапим виртуальные пути типов для фронтенда
      "sap/*": [
        "./node_modules/@sapui5/types/types/sap/*"
      ]
    }
  },
  "include": [
    "srv/**/*",
    "db/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "webapp" // Exclude webapp from compilation, as it is a frontend project
  ]
}