{
  "name": "cat-connect",
  "version": "1.0.24",
  "dependencies": {
    "@cap-js/hana": "^3.0.1",
    "@sap/approuter": "^22.0.3",
    "@sap/cds": "^9",
    "@sap/cds-dk": "^9",
    "@sap/xssec": "^4.13.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^2.4.0",
    "cds-plugin-ui5": "^0.9.1",
    "supertest": "^7.2.2"
  },
  "scripts": {
    "start": "cds-serve",
    "start-dev": "cds watch --in-memory",
    "watch-crm_customers": "cds watch --open crmcustomers/index.html?sap-ui-xx-viewCache=false --livereload false",
    "test": "node --test",
    "test:crm": "npx jest test/CrmService.test.js --verbose --runInBand",
    "build": "cds build --production"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/gameshop",
    "app/crm_customers"
  ],
    "cds": {
    "requires": {
      "db": {
        "kind": "sqlite"
      },
      "folders": {
        "data": "db/test"
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "admin": { "roles": ["authenticated-user", "CRMAdmin", "SalesManager", "SupportAgent"] },
            "manager": { "roles": ["authenticated-user", "SalesManager"] },
            "agent": { "roles": ["authenticated-user", "SupportAgent"] }
          }
        },
        "[production]": {
          "kind": "dummy"
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        }
      }
    }
  }
}
