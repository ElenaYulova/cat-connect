{
  "name": "cat-connect",
  "version": "1.1.28",
  "dependencies": {
    "@cap-js/hana": "^3.0.1",
    "@sap/cds": "^9",
    "@sap/cds-dk": "^9",
    "@sap/xssec": "^4.13.0",
    "openui5-runtime": "^1.50.5"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^2.4.0",
    "@openui5/ts-types": "^1.150.0",
    "@sap/ux-ui5-tooling": "^1.14.0",
    "@sapui5/types": "^1.150.0",
    "@types/express": "^5.0.6",
    "@ui5/cli": "^4.0.57",
    "cds-plugin-ui5": "^0.9.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "ui5-middleware-index": "^3.1.4",
    "ui5-middleware-route-proxy": "^1.0.10",
    "ui5-middleware-serveframework": "^3.8.2",
    "ui5-middleware-simpleproxy": "^3.8.0",
    "ui5-task-babel": "^2.1.0",
    "ui5-tooling-transpile": "^3.12.0"
  },
  "scripts": {
    "start": "cds-serve",
    "start-dev": "cds watch --in-memory",
    "watch-crm_customers": "cds watch --open crmcustomers/index.html?sap-ui-xx-viewCache=false --livereload false",
    "test:crm": "npx jest test/CrmService.test.js --verbose --runInBand",
    "test:sales": "npx jest test/SalesOrderService.test.js --verbose --runInBand",
    "test:cart": "npx jest test/CartManager.test.js --verbose --runInBand",
    "test": "npm run test:crm && npm run test:sales && npm run test:cart",
    "build": "ui5 build --config ui5.yaml --clean-dest --dest dist && cds build --production && cp webapp/launchpad.html dist/ && mkdir -p router/sales_order && cp -r dist/. router/sales_order/ 2>/dev/null || true",
    "start-so": "ui5 serve --config ui5.yaml --port 8090"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/gameshop",
    "app/crm_customers",
    "app/mdm-management"
  ],
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite"
      },
      "folders": {
        "data": "db/test"
      },
      "watch": {
        "exclude": [
          "webapp"
        ]
      },
      "cds-plugin-ui5": {
        "modules": {
          "sales_order": {
            "configFile": "ui5.yaml",
            "mountPath": "/"
          }
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "admin": {
              "roles": [
                "authenticated-user",
                "CRMAdmin",
                "SalesManager",
                "SupportAgent"
              ]
            },
            "manager": {
              "roles": [
                "authenticated-user",
                "SalesManager"
              ]
            },
            "user": {
              "roles": [
                "authenticated-user",
                "Customer"
              ]
            },
            "agent": {
              "roles": [
                "authenticated-user",
                "SupportAgent"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        }
      }
    }
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}