{
  "name": "cat-connect",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0",
    "supertest": "^7.2.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-crm_customers": "cds watch --open crmcustomers/index.html?sap-ui-xx-viewCache=false --livereload false",
    "test": "node --test",
    "test:crm": "npx jest test/CrmService.test.js --verbose --runInBand"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/gameshop",
    "app/crm_customers"
  ],
  "cds": {
    "requires": {
      "auth": {
        "strategy": "mock",
        "users": {
          "admin": {
            "roles": [
              "CRMAdmin",
              "SalesManager",
              "SupportAgent"
            ]
          },
          "manager": {
            "roles": [
              "SalesManager"
            ]
          },
          "agent": {
            "roles": [
              "SupportAgent"
            ]
          }
        }
      }
    }
  }
}
